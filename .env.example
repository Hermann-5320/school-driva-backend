# Copier en .env et remplir. NE JAMAIS committer le fichier .env.
# Générer un secret : openssl rand -hex 48

POSTGRES_PASSWORD=
APP_JWT_SECRET=            # >= 64 caractères aléatoires
APP_INTERNAL_API_KEY=      # >= 64 caractères aléatoires

SERPAPI_KEY=
# Itinéraires routiers (gratuit : openrouteservice.org). Vide = estimation vol d'oiseau × 1,4
ORS_API_KEY=
CTPAY_TOKEN=

# Emails : BREVO_API_KEY (recommandé) OU Gmail (SMTP). Sinon, emails écrits dans les logs.
BREVO_API_KEY=
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:9090
